{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/enquiries/[id]/email",
      "regex": "^/api/enquiries/([^/]+?)/email(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/enquiries/(?<nxtPid>[^/]+?)/email(?:/)?$"
    },
    {
      "page": "/api/enquiries/[id]/notes",
      "regex": "^/api/enquiries/([^/]+?)/notes(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/enquiries/(?<nxtPid>[^/]+?)/notes(?:/)?$"
    },
    {
      "page": "/api/enquiries/[id]/update",
      "regex": "^/api/enquiries/([^/]+?)/update(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/enquiries/(?<nxtPid>[^/]+?)/update(?:/)?$"
    },
    {
      "page": "/api/referrals/[id]/mark-paid",
      "regex": "^/api/referrals/([^/]+?)/mark\\-paid(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/referrals/(?<nxtPid>[^/]+?)/mark\\-paid(?:/)?$"
    },
    {
      "page": "/enquiries/[id]",
      "regex": "^/enquiries/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/enquiries/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/enquiries/[id]/compose",
      "regex": "^/enquiries/([^/]+?)/compose(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/enquiries/(?<nxtPid>[^/]+?)/compose(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/activity",
      "regex": "^/activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/activity(?:/)?$"
    },
    {
      "page": "/auth/callback",
      "regex": "^/auth/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/callback(?:/)?$"
    },
    {
      "page": "/auth/forgot",
      "regex": "^/auth/forgot(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/forgot(?:/)?$"
    },
    {
      "page": "/auth/reset",
      "regex": "^/auth/reset(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/reset(?:/)?$"
    },
    {
      "page": "/auth/sign-in",
      "regex": "^/auth/sign\\-in(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/sign\\-in(?:/)?$"
    },
    {
      "page": "/auth/sign-out",
      "regex": "^/auth/sign\\-out(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/sign\\-out(?:/)?$"
    },
    {
      "page": "/auth/sign-up",
      "regex": "^/auth/sign\\-up(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/sign\\-up(?:/)?$"
    },
    {
      "page": "/pipeline",
      "regex": "^/pipeline(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pipeline(?:/)?$"
    },
    {
      "page": "/referrals",
      "regex": "^/referrals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/referrals(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}