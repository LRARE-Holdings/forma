# Copy to .env.local for local development. Never commit real values.

# Supabase (Forma DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Prices are found by lookup key (forma_<tier>_monthly / _annual);
# create them with `pnpm stripe:setup`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Free-trial length for annual plans, in days. 0 or empty = no trial.
ANNUAL_TRIAL_DAYS=

# Email
RESEND_API_KEY=
# Where new paid signups, cancellations and failed payments are reported.
ADMIN_EMAIL=

NEXT_PUBLIC_SITE_URL=https://useforma.co.uk

# Set to "off" to lift the maintenance wall.
MAINTENANCE_MODE=
