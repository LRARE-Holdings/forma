{
  "name": "forma-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @forma/marketing dev",
    "dev:marketing": "pnpm --filter @forma/marketing dev",
    "dev:portal": "pnpm --filter @forma/portal dev",
    "build": "pnpm -r build",
